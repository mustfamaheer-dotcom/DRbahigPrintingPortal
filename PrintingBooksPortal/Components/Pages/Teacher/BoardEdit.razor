@page "/teacher/boards"
@attribute [Authorize(Roles = "Teacher")]
@rendermode InteractiveServer
@inject AppDbContext Db
@inject ITenantContext Tenant

<div class="content-area">
    <div class="page-header">
        <div>
            <h1>My Boards</h1>
            <p class="page-subtitle">Manage your educational boards</p>
        </div>
        <div class="page-header-actions">
            <button class="btn btn-primary" @onclick="() => { editModel = new(); editing = false; showModal = true; }">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Add Board
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-modern alert-success">@message</div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-modern alert-danger">@error</div>
    }

    @* Board Modal *@
    <div class="modal-overlay @(showModal ? "show" : "")" @onclick="() => showModal = false">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <h5 class="modal-title">@(editing ? "Edit Board" : "Add New Board")</h5>
                <button type="button" class="modal-close" @onclick="() => showModal = false">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Board Name</label>
                    <input @bind="editModel.Name" class="form-control form-control-modern" placeholder="e.g. Cambridge IGCSE" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea @bind="editModel.Description" class="form-control form-control-modern" rows="3" placeholder="Optional description"></textarea>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => showModal = false">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveBoard">@(editing ? "Update" : "Create")</button>
                </div>
            </div>
        </div>
    </div>

    @* Delete Confirmation *@
    <div class="modal-overlay @(showDeleteModal ? "show" : "")" @onclick="() => showDeleteModal = false">
        <div class="modal-container modal-sm" @onclick:stopPropagation>
            <div class="modal-body text-center py-4">
                <div class="delete-icon mb-3">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--danger)" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                </div>
                <h5 class="mb-2">Delete Board</h5>
                <p class="text-muted mb-3">
                    @if (deletingBoard != null && deletingBoard.Books.Count > 0)
                    {
                        <span class="text-danger">This board has @deletingBoard.Books.Count book(s). Delete them first.</span>
                    }
                    else
                    {
                        <span>Are you sure you want to delete this board?</span>
                    }
                </p>
                <div class="modal-actions justify-content-center">
                    <button class="btn btn-outline-secondary" @onclick="() => showDeleteModal = false">Cancel</button>
                    @if (deletingBoard == null || deletingBoard.Books.Count == 0)
                    {
                        <button class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="content-card">
        <div class="card-body p-0">
            @if (boards == null)
            {
                <div class="loading-placeholder">Loading...</div>
            }
            else if (!boards.Any())
            {
                <div class="empty-state">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--gray-300)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                    <p>No boards yet. Add your first educational board.</p>
                </div>
            }
            else
            {
                <div class="table-container">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Books</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var board in boards)
                            {
                                <tr>
                                    <td><strong>@board.Name</strong></td>
                                    <td class="text-muted">@board.Description</td>
                                    <td><span class="status-badge status-active">@board.Books.Count</span></td>
                                    <td>
                                        <span class="status-badge @(board.IsActive ? "status-active" : "status-inactive")">
                                            <span class="status-dot"></span>
                                            @(board.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-muted">@board.CreatedAt.ToLocalTime().ToString("d")</td>
                                    <td class="text-end">
                                        <div class="action-btns">
                                            <button class="btn-icon btn-icon-edit" title="Edit" @onclick="() => { editModel.Name = board.Name; editModel.Description = board.Description; editing = true; editingId = board.Id; showModal = true; }">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                            </button>
                                            <button class="btn-icon btn-icon-toggle" title="Toggle" @onclick="() => ToggleBoard(board)">
                                                @if (board.IsActive)
                                                {
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                                }
                                                else
                                                {
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                                }
                                            </button>
                                            <button class="btn-icon btn-icon-danger" title="Delete" @onclick="() => { deletingBoard = board; showDeleteModal = true; }">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<EducationalBoard>? boards;
    private BoardEditModel editModel = new();
    private bool editing;
    private int editingId;
    private bool showModal;
    private bool showDeleteModal;
    private EducationalBoard? deletingBoard;
    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await Tenant.InitializeAsync();
        await LoadBoards();
    }

    private async Task LoadBoards()
    {
        try
        {
            if (Tenant.TeacherId == null)
            {
                error = "Teacher account not linked. Please log out and log back in.";
                boards = new();
                return;
            }
            boards = await Db.EducationalBoards
                .Where(b => b.TeacherId == Tenant.TeacherId.Value)
                .Include(b => b.Books)
                .OrderBy(b => b.Name)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            error = $"Failed to load boards: {ex.Message}";
            boards = new();
        }
    }

    private async Task SaveBoard()
    {
        error = null;
        try
        {
            if (Tenant.TeacherId == null)
            {
                error = "Teacher account not linked. Please log out and log back in.";
                return;
            }

            if (editing)
            {
                var board = await Db.EducationalBoards.FindAsync(editingId);
                if (board != null)
                {
                    board.Name = editModel.Name;
                    board.Description = editModel.Description;
                }
            }
            else
            {
                Db.EducationalBoards.Add(new EducationalBoard
                {
                    TeacherId = Tenant.TeacherId.Value,
                    Name = editModel.Name,
                    Description = editModel.Description
                });
            }

            await Db.SaveChangesAsync();
            message = editing ? "Board updated." : "Board created.";
            await LoadBoards();
            showModal = false;
            editModel = new();
            editing = false;
        }
        catch (Exception ex)
        {
            error = $"Failed to save board: {ex.Message}";
        }
    }

    private async Task ToggleBoard(EducationalBoard board)
    {
        board.IsActive = !board.IsActive;
        await Db.SaveChangesAsync();
        await LoadBoards();
    }

    private async Task ConfirmDelete()
    {
        if (deletingBoard == null || deletingBoard.Books.Count > 0) return;
        Db.EducationalBoards.Remove(deletingBoard);
        await Db.SaveChangesAsync();
        await LoadBoards();
        message = $"Board '{deletingBoard.Name}' deleted.";
        showDeleteModal = false;
        deletingBoard = null;
    }

    private class BoardEditModel
    {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
    }
}