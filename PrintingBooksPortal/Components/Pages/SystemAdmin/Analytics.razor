@page "/sa/analytics"
@attribute [Authorize(Roles = "SystemAdmin")]
@inject SystemAdminService Sa

<div class="content-area">
    <div class="page-header">
        <div>
            <h1>Platform Analytics</h1>
            <p class="page-subtitle">Aggregated usage across all tenants</p>
        </div>
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-modern alert-danger">@errorMessage</div>
    }

    <div class="row g-4 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-primary">
                <div class="stat-card-bg"></div>
                <div class="stat-card-inner">
                    <div class="stat-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    <div class="stat-info">
                        <div class="stat-label">Shops</div>
                        <div class="stat-value">@(summary?.totals?.shops ?? 0)</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-success">
                <div class="stat-card-bg"></div>
                <div class="stat-card-inner">
                    <div class="stat-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    </div>
                    <div class="stat-info">
                        <div class="stat-label">Books</div>
                        <div class="stat-value">@(summary?.totals?.books ?? 0)</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-purple">
                <div class="stat-card-bg"></div>
                <div class="stat-card-inner">
                    <div class="stat-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                    </div>
                    <div class="stat-info">
                        <div class="stat-label">Boards</div>
                        <div class="stat-value">@(summary?.totals?.boards ?? 0)</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-warning">
                <div class="stat-card-bg"></div>
                <div class="stat-card-inner">
                    <div class="stat-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    </div>
                    <div class="stat-info">
                        <div class="stat-label">Total Prints</div>
                        <div class="stat-value">@(summary?.totals?.prints ?? 0)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="content-card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5>Usage Per Tenant</h5>
            <a href="/sa/teachers" class="btn btn-sm btn-header-link">All Teachers</a>
        </div>
        <div class="card-body p-0">
            @if (summary?.perTenant == null)
            {
                <div class="loading-placeholder">Loading...</div>
            }
            else if (!summary.perTenant.Any())
            {
                <div class="empty-state"><p>No tenants yet</p></div>
            }
            else
            {
                var maxPrints = summary.perTenant.Max(t => t.prints);
                <div class="table-container">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Tenant</th>
                                <th>Status</th>
                                <th>Shops</th>
                                <th style="width:260px;">Print Share</th>
                                <th class="text-end">Prints</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in summary.perTenant.OrderByDescending(t => t.prints))
                            {
                                var pct = maxPrints <= 0 ? 0 : (int)((double)t.prints / maxPrints * 100);
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="avatar-initials avatar-sm" style="background: hsl(@HFor(t.tenantName) 62% 46%);">@Initials(t.tenantName)</span>
                                            <span class="fw-semibold">@t.tenantName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="status-badge @(t.isActive ? "status-active" : "status-inactive")">
                                            <span class="status-dot"></span>
                                            @(t.isActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td><span class="count-badge">@t.shops</span></td>
                                    <td>
                                        <div class="progress-track"><div class="progress-fill" style="width: @(pct)%;"></div></div>
                                    </td>
                                    <td class="text-end"><span class="count-badge count-bubble">@t.prints</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private PlatformSummary? summary;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            summary = await Sa.GetPlatformSummaryAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load analytics: {ex.Message}";
        }
    }

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var words = name.Split([' ', '-', '_'], StringSplitOptions.RemoveEmptyEntries);
        return words.Length > 1 ? $"{words[0][0]}{words[1][0]}".ToUpper() : words[0][..1].ToUpper();
    }

    private static int HFor(string text)
    {
        var sum = 0;
        foreach (var c in text) sum += c;
        return sum % 360;
    }
}