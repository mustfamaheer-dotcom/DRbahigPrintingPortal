@page "/teacher/bookshops"
@attribute [Authorize(Roles = "Teacher")]
@rendermode InteractiveServer
@inject AppDbContext Db
@inject ITenantContext Tenant
@inject HttpClient Http
@inject ILogger<Bookshops> _logger

<div class="content-area">
    <div class="page-header">
        <div>
            <h1>Bookshop Management</h1>
            <p class="page-subtitle">Manage bookshops linked to your account and their login accounts</p>
        </div>
        <div class="page-header-actions">
            <button class="btn btn-primary" @onclick="() => { showLinkModal = true; }">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Link Bookshop
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-modern alert-success">@((MarkupString)message)</div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-modern alert-danger">@error</div>
    }

    @* Link Bookshop Modal *@
    <div class="modal-overlay @(showLinkModal ? "show" : "")" @onclick="() => showLinkModal = false">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <h5 class="modal-title">Link a New Bookshop</h5>
                <button type="button" class="modal-close" @onclick="() => showLinkModal = false">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Bookshop Name</label>
                    <input @bind="newBookshopName" class="form-control form-control-modern" placeholder="e.g. Cairo Bookstore" />
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Contact Person</label>
                        <input @bind="newContactPerson" class="form-control form-control-modern" placeholder="e.g. Ahmed Ali" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Phone</label>
                        <input @bind="newPhone" class="form-control form-control-modern" placeholder="Phone number" />
                    </div>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelLink">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="LinkBookshop" disabled="string.IsNullOrWhiteSpace(newBookshopName)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                        Link Bookshop
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* Create User Modal *@
    <div class="modal-overlay @(showCreateUserModal ? "show" : "")" @onclick="() => showCreateUserModal = false">
        <div class="modal-container modal-sm" @onclick:stopPropagation>
            <div class="modal-header">
                <h5 class="modal-title">Create Login Account</h5>
                <button type="button" class="modal-close" @onclick="() => showCreateUserModal = false">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">Create a login account for <strong>@createUserShopName</strong> so they can access the bookshop portal.</p>
                <div class="mb-3">
                    <label class="form-label">Email (Username)</label>
                    <input @bind="createUserEmail" type="email" class="form-control form-control-modern" placeholder="bookshop@example.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input @bind="createUserPassword" type="password" class="form-control form-control-modern" placeholder="Min 6 characters" />
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => showCreateUserModal = false">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="CreateUser" disabled="string.IsNullOrWhiteSpace(createUserEmail) || string.IsNullOrWhiteSpace(createUserPassword)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6"/><path d="M22 11h-6"/></svg>
                        Create Account
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* Reset Password Modal *@
    <div class="modal-overlay @(showResetPwModal ? "show" : "")" @onclick="() => showResetPwModal = false">
        <div class="modal-container modal-sm" @onclick:stopPropagation>
            <div class="modal-header">
                <h5 class="modal-title">Reset Password</h5>
                <button type="button" class="modal-close" @onclick="() => showResetPwModal = false">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">Reset password for <strong>@resetPwShopName</strong>.</p>
                <div class="mb-3">
                    <label class="form-label">New Password</label>
                    <input @bind="resetPwPassword" type="password" class="form-control form-control-modern" placeholder="Min 6 characters" />
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => showResetPwModal = false">Cancel</button>
                    <button type="button" class="btn btn-warning" @onclick="ResetPassword" disabled="string.IsNullOrWhiteSpace(resetPwPassword)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        Reset Password
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* Reset Stats Modal *@
    <div class="modal-overlay @(showResetModal ? "show" : "")" @onclick="() => showResetModal = false">
        <div class="modal-container modal-sm" @onclick:stopPropagation>
            <div class="modal-body text-center py-4">
                <div class="delete-icon mb-3">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--warning)" stroke-width="1.5"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                </div>
                <h5 class="mb-2">Reset Statistics</h5>
                <p class="text-muted mb-3">Generate invoice and reset print counters for <strong>@resettingShopName</strong>?</p>
                <div class="modal-actions justify-content-center">
                    <button class="btn btn-outline-secondary" @onclick="() => showResetModal = false">Cancel</button>
                    <button class="btn btn-warning" @onclick="ConfirmReset">Reset & Invoice</button>
                </div>
            </div>
        </div>
    </div>

    @* Unlink Confirmation *@
    <div class="modal-overlay @(showUnlinkModal ? "show" : "")" @onclick="() => showUnlinkModal = false">
        <div class="modal-container modal-sm" @onclick:stopPropagation>
            <div class="modal-body text-center py-4">
                <div class="delete-icon mb-3">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--danger)" stroke-width="1.5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                </div>
                <h5 class="mb-2">Unlink Bookshop</h5>
                <p class="text-muted mb-3">Deactivate <strong>@unlinkingShopName</strong>?</p>
                <div class="modal-actions justify-content-center">
                    <button class="btn btn-outline-secondary" @onclick="() => showUnlinkModal = false">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmUnlink">Deactivate</button>
                </div>
            </div>
        </div>
    </div>

    <div class="content-card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5>Linked Bookshops <span class="text-muted fs-6 fw-normal">(@links?.Count ?? 0)</span></h5>
        </div>
        <div class="card-body p-0">
            @if (links == null)
            {
                <div class="loading-placeholder">Loading...</div>
            }
            else if (!links.Any())
            {
                <div class="empty-state">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--gray-300)" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    <p>No bookshops linked yet.</p>
                </div>
            }
            else
            {
                <div class="table-container">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Bookshop</th>
                                <th>Contact</th>
                                <th>Copies</th>
                                <th>Login Account</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var link in links)
                            {
                                <tr>
                                    <td><strong>@link.BookshopName</strong></td>
                                    <td>
                                        <div>@link.ContactPerson</div>
                                        <small class="text-muted">@link.Phone</small>
                                    </td>
                                    <td><span class="status-badge status-active">@link.CopiesPrinted</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(link.UserEmail))
                                        {
                                            <span class="status-badge status-active" style="font-size:0.75rem;">@link.UserEmail</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inactive">No account</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="status-badge @(link.IsActive ? "status-active" : "status-inactive")">
                                            <span class="status-dot"></span>
                                            @(link.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="action-btns">
                                            @if (string.IsNullOrEmpty(link.UserEmail))
                                            {
                                                <button class="btn-icon btn-icon-primary" title="Create Login Account" @onclick="() => { createUserLinkId = link.Id; createUserShopName = link.BookshopName; showCreateUserModal = true; }">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6"/><path d="M22 11h-6"/></svg>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn-icon btn-icon-warning" title="Reset Password" @onclick="() => { resetPwLinkId = link.Id; resetPwShopName = link.BookshopName; showResetPwModal = true; }">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                                </button>
                                            }
                                            <button class="btn-icon btn-icon-toggle" title="Toggle" @onclick="() => ToggleLink(link)">
                                                @if (link.IsActive)
                                                {
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                                }
                                                else
                                                {
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                                }
                                            </button>
                                            <button class="btn-icon btn-icon-warning" title="Reset Stats" @onclick="() => { resettingLink = link; resettingShopName = link.BookshopName; showResetModal = true; }">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                                            </button>
                                            <button class="btn-icon btn-icon-danger" title="Deactivate" @onclick="() => { unlinkingLink = link; unlinkingShopName = link.BookshopName; showUnlinkModal = true; }">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<LinkView>? links;
    private string newBookshopName = "";
    private string newContactPerson = "";
    private string newPhone = "";
    private bool showLinkModal;
    private bool showResetModal;
    private bool showUnlinkModal;
    private bool showCreateUserModal;
    private bool showResetPwModal;
    private LinkView? resettingLink;
    private string resettingShopName = "";
    private LinkView? unlinkingLink;
    private string unlinkingShopName = "";
    private int createUserLinkId;
    private string createUserShopName = "";
    private string createUserEmail = "";
    private string createUserPassword = "";
    private int resetPwLinkId;
    private string resetPwShopName = "";
    private string resetPwPassword = "";
    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await Tenant.InitializeAsync();
        await LoadLinks();
    }

    private async Task LoadLinks()
    {
        try
        {
            if (Tenant.TeacherId == null) return;
            var tid = Tenant.TeacherId.Value;

            var rawLinks = await Db.TeacherBookshopLinks
                .AsNoTracking()
                .Where(l => l.TeacherId == tid)
                .Include(l => l.Bookshop)
                .OrderByDescending(l => l.CreatedAt)
                .ToListAsync();

            var bookshopIds = rawLinks.Select(l => l.BookshopId).ToList();
            List<ApplicationUser>? users = new();
            if (bookshopIds.Any())
            {
                users = await Db.Users
                    .AsNoTracking()
                    .Where(u => u.BookshopId != null && bookshopIds.Contains(u.BookshopId.Value))
                    .ToListAsync();
            }
            var userMap = users.Where(u => u.BookshopId != null).ToDictionary(u => u.BookshopId!.Value, u => u.Email ?? "");

            links = rawLinks.Select(l => new LinkView
            {
                Id = l.Id,
                BookshopName = l.Bookshop.Name,
                ContactPerson = l.Bookshop.ContactPerson,
                Phone = l.Bookshop.Phone,
                CopiesPrinted = l.CopiesPrinted,
                UniqueApiKey = l.UniqueApiKey,
                IsActive = l.IsActive,
                UserEmail = userMap.GetValueOrDefault(l.BookshopId, "")
            }).ToList();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to load bookshop links for teacher {TeacherId}", Tenant.TeacherId);
            error = $"Failed to load links: {ex.Message}";
            links = new();
        }
    }

    private async Task LinkBookshop()
    {
        error = null;
        try
        {
            if (Tenant.TeacherId == null || string.IsNullOrWhiteSpace(newBookshopName)) return;
            var tid = Tenant.TeacherId.Value;

            var shop = await Db.Bookshops.AsNoTracking().FirstOrDefaultAsync(b => b.Name == newBookshopName);
            if (shop == null)
            {
                shop = new Bookshop { Name = newBookshopName, ContactPerson = newContactPerson, Phone = newPhone };
                Db.Bookshops.Add(shop);
                await Db.SaveChangesAsync();
            }

            var exists = await Db.TeacherBookshopLinks.AsNoTracking().AnyAsync(l => l.TeacherId == tid && l.BookshopId == shop.Id);
            if (exists)
            {
                error = "This bookshop is already linked.";
                return;
            }

            Db.TeacherBookshopLinks.Add(new TeacherBookshopLink
            {
                TeacherId = tid,
                BookshopId = shop.Id,
                UniqueApiKey = Convert.ToHexString(System.Security.Cryptography.RandomNumberGenerator.GetBytes(32)),
                IsActive = true
            });
            await Db.SaveChangesAsync();
            message = $"Bookshop '{newBookshopName}' linked!";
            CancelLink();
            await LoadLinks();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to link bookshop for teacher {TeacherId}", Tenant.TeacherId);
            error = $"Failed to link bookshop: {ex.Message}";
        }
    }

    private void CancelLink()
    {
        showLinkModal = false;
        newBookshopName = "";
        newContactPerson = "";
        newPhone = "";
    }

    private async Task ToggleLink(LinkView link)
    {
        if (Tenant.TeacherId == null) return;
        var dbLink = await Db.TeacherBookshopLinks
            .Where(l => l.Id == link.Id && l.TeacherId == Tenant.TeacherId.Value)
            .FirstOrDefaultAsync();
        if (dbLink != null) { dbLink.IsActive = !dbLink.IsActive; await Db.SaveChangesAsync(); await LoadLinks(); }
    }

    private async Task ConfirmReset()
    {
        if (resettingLink == null || Tenant.TeacherId == null) return;
        var dbLink = await Db.TeacherBookshopLinks.Include(l => l.Bookshop).FirstOrDefaultAsync(l => l.Id == resettingLink.Id && l.TeacherId == Tenant.TeacherId.Value);
        if (dbLink == null) return;

        if (dbLink.CopiesPrinted > 0)
        {
            Db.Invoices.Add(new Invoice
            {
                TeacherBookshopLinkId = dbLink.Id,
                PeriodStart = dbLink.LastResetDate,
                PeriodEnd = DateTime.UtcNow,
                TotalCopies = dbLink.CopiesPrinted,
                TotalAmount = dbLink.CopiesPrinted * 1.0m,
                Status = InvoiceStatus.Pending
            });
        }
        dbLink.CopiesPrinted = 0;
        dbLink.LastResetDate = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        message = $"Stats reset for '{resettingShopName}'. Invoice generated.";
        showResetModal = false;
        await LoadLinks();
    }

    private async Task ConfirmUnlink()
    {
        if (unlinkingLink == null || Tenant.TeacherId == null) return;
        var dbLink = await Db.TeacherBookshopLinks.FirstOrDefaultAsync(l => l.Id == unlinkingLink.Id && l.TeacherId == Tenant.TeacherId.Value);
        if (dbLink == null) return;
        dbLink.IsActive = false;
        await Db.SaveChangesAsync();
        message = $"Bookshop '{unlinkingShopName}' deactivated.";
        showUnlinkModal = false;
        await LoadLinks();
    }

    private async Task CreateUser()
    {
        error = null;
        try
        {
            var response = await Http.PostAsJsonAsync($"/api/teacher/bookshops/{createUserLinkId}/create-user",
                new { email = createUserEmail, password = createUserPassword });
            var body = await response.Content.ReadAsStringAsync();
            if (response.IsSuccessStatusCode)
            {
                message = "User created! They can now log in at /login.";
                showCreateUserModal = false;
                createUserEmail = "";
                createUserPassword = "";
                await LoadLinks();
            }
            else
            {
                var err = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(body);
                var msg = "";
                if (err.TryGetProperty("error", out var e)) msg = e.GetString() ?? "";
                else if (err.TryGetProperty("message", out var m)) msg = m.GetString() ?? "";
                else if (err.TryGetProperty("errors", out var arr)) msg = string.Join("; ", arr.EnumerateArray().Select(x => x.GetString()));
                error = string.IsNullOrEmpty(msg) ? "Failed to create user." : msg;
            }
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
    }

    private async Task ResetPassword()
    {
        error = null;
        try
        {
            var response = await Http.PostAsJsonAsync($"/api/teacher/bookshops/{resetPwLinkId}/reset-password",
                new { newPassword = resetPwPassword });
            var result = await response.Content.ReadFromJsonAsync<ApiResult>();
            if (response.IsSuccessStatusCode)
            {
                message = result?.message ?? "Password reset!";
                showResetPwModal = false;
                resetPwPassword = "";
            }
            else
            {
                error = result?.message ?? result?.error ?? "Failed to reset password.";
            }
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
    }

    private async Task CopyKey(string key)
    {
        await Task.Run(() => { });
        message = "API key copied!";
    }

    private class ApiResult
    {
        public bool success { get; set; }
        public string? message { get; set; }
        public string? error { get; set; }
    }

    private class LinkView
    {
        public int Id { get; set; }
        public string BookshopName { get; set; } = "";
        public string? ContactPerson { get; set; }
        public string? Phone { get; set; }
        public int CopiesPrinted { get; set; }
        public string UniqueApiKey { get; set; } = "";
        public bool IsActive { get; set; }
        public string UserEmail { get; set; } = "";
    }
}