@page "/teacher/history"
@attribute [Authorize(Roles = "Teacher")]
@rendermode InteractiveServer
@inject AppDbContext Db
@inject ITenantContext Tenant

<div class="content-area">
    <div class="page-header">
        <div>
            <h1>Print History</h1>
            <p class="page-subtitle">View your printing activity across all bookshops</p>
        </div>
        <div class="page-header-actions">
            <span class="text-muted fs-6">Total: <strong>@logs?.Sum(l => l.Copies) ?? 0</strong> copies</span>
        </div>
    </div>

    <div class="content-card">
        <div class="card-body p-0">
            @if (logs == null)
            {
                <div class="loading-placeholder">Loading...</div>
            }
            else if (!logs.Any())
            {
                <div class="empty-state">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--gray-300)" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <p>No print history yet.</p>
                </div>
            }
            else
            {
                <div class="table-container">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Date/Time</th>
                                <th>Book</th>
                                <th>Copies</th>
                                <th>Printed By</th>
                                <th>Bookshop</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in logs)
                            {
                                <tr>
                                    <td><small class="text-muted">@log.PrintedAt.ToLocalTime().ToString("g")</small></td>
                                    <td><strong>@log.BookTitle</strong></td>
                                    <td><span class="status-badge status-active">@log.Copies</span></td>
                                    <td>@log.PrintedByUserName</td>
                                    <td>@log.ShopName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<PrintLog>? logs;

    protected override async Task OnInitializedAsync()
    {
        await Tenant.InitializeAsync();
        if (Tenant.TeacherId == null) return;
        try
        {
            logs = await Db.PrintLogs
                .Where(l => l.TeacherId == Tenant.TeacherId.Value)
                .OrderByDescending(l => l.PrintedAt)
                .Take(200)
                .ToListAsync();
        }
        catch { }
    }
}