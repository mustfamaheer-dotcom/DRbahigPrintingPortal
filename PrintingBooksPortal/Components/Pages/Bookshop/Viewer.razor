@page "/bookshop/viewer/{BookId:int}"
@attribute [Authorize(Roles = "BookshopManager")]
@rendermode InteractiveServer
@inject AppDbContext Db
@inject AuthenticationStateProvider AuthState
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (book == null)
{
    <div class="viewer-unauthorized">
        <div class="unauthorized-card">
            <div class="unauthorized-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <h2>Access Restricted</h2>
            <p>You don't have permission to view this book.</p>
            <a href="/bookshop/dashboard" class="unauthorized-back">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Back to Dashboard
            </a>
        </div>
    </div>
}
else
{
    <div class="viewer-layout">
        <header class="viewer-header">
            <div class="viewer-header-inner">
                <div class="viewer-brand">
                    <a href="/bookshop/dashboard" class="viewer-back" title="Back">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                    </a>
                    <div class="viewer-book-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    </div>
                    <div class="viewer-title-block">
                        <span class="viewer-eyebrow">@book.TeacherName</span>
                        <h1 class="viewer-title">@book.Title</h1>
                    </div>
                </div>
                <div class="viewer-toolbar">
                    <button class="btn btn-primary btn-sm" @onclick="PrintBook" disabled="printing">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                        @(printing ? "Printing..." : "Print")
                    </button>
                </div>
            </div>
        </header>
        <div class="viewer-body">
            <iframe src="@pdfUrl" class="viewer-iframe" allowfullscreen></iframe>
        </div>
    </div>
}

@code {
    [Parameter] public int BookId { get; set; }

    private BookView? book;
    private string pdfUrl = "";
    private bool printing;

    protected override async Task OnInitializedAsync()
    {
        await LoadBook();
    }

    private async Task LoadBook()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true) return;

        var appUser = await UserManager.GetUserAsync(authState.User);
        if (appUser == null || appUser.BookshopId == null) return;

        var bid = appUser.BookshopId.Value;
        var teacherIds = await Db.TeacherBookshopLinks
            .Where(l => l.BookshopId == bid && l.IsActive)
            .Select(l => l.TeacherId)
            .Distinct()
            .ToListAsync();

        var dbBook = await Db.Books
            .Where(b => b.Id == BookId && teacherIds.Contains(b.TeacherId!.Value) && b.IsActive)
            .Include(b => b.Teacher)
            .FirstOrDefaultAsync();

        if (dbBook == null) return;

        book = new BookView
        {
            Id = dbBook.Id,
            Title = dbBook.Title,
            TeacherName = dbBook.Teacher?.Name ?? "Unknown",
            FilePath = dbBook.FilePath,
            EnableWatermark = dbBook.EnableWatermark
        };

        var watermark = book.EnableWatermark ? $"?watermark={Uri.EscapeDataString(appUser.Bookshop?.Name ?? appUser.UserName ?? "")}" : "";
        pdfUrl = $"/api/books/{BookId}/pdf{watermark}";
    }

    private async Task PrintBook()
    {
        if (book == null || printing) return;
        printing = true;

        try
        {
            var jobId = Guid.NewGuid().ToString("N");
            await JS.InvokeVoidAsync("eval", $"window.open('/bookshop/dashboard', '_blank')");
            Navigation.NavigateTo($"/api/books/{BookId}/pdf?print=1", true);
        }
        catch { }
        finally
        {
            printing = false;
        }
    }

    private class BookView
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string TeacherName { get; set; } = "";
        public string FilePath { get; set; } = "";
        public bool EnableWatermark { get; set; }
    }
}