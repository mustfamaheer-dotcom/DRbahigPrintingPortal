@namespace PrintingBooksPortal.Components.Pages.Teacher
@inject MudDialogInstance MudDialog

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Reset Statistics</MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Resetting stats will generate a final invoice for <strong>@BookshopName</strong> with all current copies printed. Counters will be reset to zero.
        </MudAlert>
        <MudText Typo="Typo.body2">Are you sure you want to proceed?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="Confirm">Reset & Generate Invoice</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string BookshopName { get; set; } = "";

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}
