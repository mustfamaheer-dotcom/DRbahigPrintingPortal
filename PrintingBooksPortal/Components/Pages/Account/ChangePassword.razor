@page "/account/change-password"
@layout LoginLayout
@attribute [Authorize]
@inject IHttpContextAccessor HttpContextAccessor

<div class="lp-shell">
    <aside class="lp-brand-panel">
        <div class="lp-bp-grid"></div>
        <div class="lp-bp-glow lp-bp-glow-1"></div>
        <div class="lp-bp-glow lp-bp-glow-2"></div>
        <div class="lp-bp-inner">
            <div class="lp-logo">
                <div class="lp-logo-icon">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                    </svg>
                </div>
                <div>
                    <div class="lp-logo-name">PrintingBooks</div>
                    <div class="lp-logo-sub">Management Portal</div>
                </div>
            </div>
            <div class="lp-tagline">
                <h1><span class="lp-gradient-text">Secure your account</span></h1>
                <p>For security, you must set a new password before continuing.</p>
            </div>
            <p class="lp-bp-credit">&copy; @DateTime.Now.Year PrintingBooks Portal</p>
        </div>
    </aside>

    <main class="lp-form-panel">
        <div class="lp-form-wrap">
            <div class="lp-form-head">
                <h2>Change password</h2>
                <p>Your current password is temporary and must be replaced</p>
            </div>

            @{
                var error = HttpContextAccessor.HttpContext?.Request.Query["error"].FirstOrDefault();
                var message = HttpContextAccessor.HttpContext?.Request.Query["message"].FirstOrDefault();
            }
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="lp-error-banner">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                    <span>@error</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="lp-error-banner" style="background:#e8f7ee;color:#1a7f37;border-color:#b5e8c8;">
                    <span>@message</span>
                </div>
            }

            <form method="post" action="/api/change-password">
                <div class="lp-field">
                    <label for="currentPassword">Current password</label>
                    <div class="lp-input-group">
                        <span class="lp-input-icon">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </span>
                        <input type="password" id="currentPassword" name="currentPassword" class="lp-input" placeholder="••••••••" autocomplete="current-password" required />
                    </div>
                </div>
                <div class="lp-field">
                    <label for="newPassword">New password</label>
                    <div class="lp-input-group">
                        <span class="lp-input-icon">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </span>
                        <input type="password" id="newPassword" name="newPassword" class="lp-input" placeholder="At least 6 characters, 1 digit" autocomplete="new-password" required />
                    </div>
                </div>
                <button type="submit" class="lp-submit">
                    Change Password
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                </button>
            </form>
        </div>
    </main>
</div>