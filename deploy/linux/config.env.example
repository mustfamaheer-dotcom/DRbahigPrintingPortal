#!/usr/bin/env bash
# ============================================================================
# Deployment configuration. Copy this file to config.env and fill in values.
# NEVER commit config.env with real passwords to version control.
# ============================================================================

# Phase 1: public IP of the VPS - the portal answers here over HTTP.
# e.g. SERVER_IP=185.10.10.10
SERVER_IP=

# Phase 2 (last step): the domain (without https://) whose A record points at
# SERVER_IP. Leave empty for phase 1; run `sudo bash enable-https.sh` after setting it.
DOMAIN=

# SA password for SQL Server on the VPS (used only during db-create + setup)
SA_PASSWORD=

# SQL Server edition PID. Use "Developer" (free, 3GB limit) or "Express" (free, 10GB limit)
MSSQL_PID=Developer

# Password for the booksportal_app login the web app uses. Also goes in appsettings.
APP_DB_PASSWORD=