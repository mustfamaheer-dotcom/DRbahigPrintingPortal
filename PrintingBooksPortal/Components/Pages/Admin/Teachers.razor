@page "/admin/teachers"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject AppDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<div class="content-area">
    <div class="page-header">
        <div>
            <h1>Teachers</h1>
            <p class="page-subtitle">Manage teachers and their accounts</p>
        </div>
        <div class="page-header-actions">
            <button class="btn btn-primary" @onclick="() => { editing = false; editModel = new(); error = null; showModal = true; }">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Add Teacher
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-modern alert-success">@message</div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-modern alert-danger">@error</div>
    }

    @* Teacher Modal *@
    <div class="modal-overlay @(showModal ? "show" : "")" @onclick="() => showModal = false">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <h5 class="modal-title">@(editing ? "Edit Teacher" : "Add New Teacher")</h5>
                <button type="button" class="modal-close" @onclick="() => showModal = false">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="modal-body">
                <EditForm Model="@editModel" OnValidSubmit="@SaveTeacher">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Teacher Name</label>
                        <InputText @bind-Value="editModel.Name" class="form-control form-control-modern" placeholder="Enter teacher name" required />
                    </div>
                    @if (!editing)
                    {
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Login Email</label>
                                <InputText @bind-Value="editModel.Email" type="email" class="form-control form-control-modern" placeholder="Email for login" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Login Password</label>
                                <InputText @bind-Value="editModel.Password" type="password" class="form-control form-control-modern" placeholder="Password" required />
                            </div>
                        </div>
                        <div class="alert alert-info py-2 px-3 mb-3">
                            <small>A user account will be created for this teacher with these credentials.</small>
                        </div>
                    }
                    <div class="modal-actions">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => showModal = false">Cancel</button>
                        <button type="submit" class="btn btn-primary">@(editing ? "Update Teacher" : "Create Teacher")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

    @* Delete Confirmation *@
    <div class="modal-overlay @(showDeleteModal ? "show" : "")" @onclick="() => showDeleteModal = false">
        <div class="modal-container modal-sm" @onclick:stopPropagation>
            <div class="modal-body text-center py-4">
                <div class="delete-icon mb-3">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--danger)" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                </div>
                <h5 class="mb-2">Delete Teacher</h5>
                <p class="text-muted mb-3">This will also delete the associated user account and all related data. Are you sure?</p>
                <div class="modal-actions justify-content-center">
                    <button class="btn btn-outline-secondary" @onclick="() => showDeleteModal = false">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                </div>
            </div>
        </div>
    </div>

    <div class="content-card">
        <div class="card-body p-0">
            @if (teachers == null)
            {
                <div class="loading-placeholder">Loading...</div>
            }
            else
            {
                <div class="table-container">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Boards</th>
                                <th>Books</th>
                                <th>Shops</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in teachers)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="shop-icon">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                            </div>
                                            <strong>@t.Name</strong>
                                        </div>
                                    </td>
                                    <td>@userEmails.GetValueOrDefault(t.Id, "—")</td>
                                    <td>@t.Boards.Count</td>
                                    <td>@t.Books.Count</td>
                                    <td>@t.BookshopLinks.Count</td>
                                    <td class="text-muted">@t.CreatedAt.ToEgyptLocal().ToString("d")</td>
                                    <td class="text-end">
                                        <div class="action-btns">
                                            <button class="btn-icon btn-icon-edit" title="Edit" @onclick="() => { editModel.Name = t.Name; editing = true; editingId = t.Id; error = null; showModal = true; }">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                            </button>
                                            <button class="btn-icon btn-icon-danger" title="Delete" @onclick="() => { deletingTeacher = t; showDeleteModal = true; }">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Teacher>? teachers;
    private Dictionary<int, string> userEmails = new();
    private TeacherEditModel editModel = new();
    private bool editing;
    private int editingId;
    private bool showModal;
    private bool showDeleteModal;
    private Teacher? deletingTeacher;
    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await LoadTeachers();
    }

    private async Task LoadTeachers()
    {
        teachers = await Db.Teachers
            .Include(t => t.Boards)
            .Include(t => t.Books)
            .Include(t => t.BookshopLinks)
            .OrderBy(t => t.Name)
            .ToListAsync();

        userEmails = new();
        foreach (var t in teachers)
        {
            var user = await UserManager.FindByIdAsync(t.UserId);
            userEmails[t.Id] = user?.Email ?? "—";
        }
    }

    private async Task SaveTeacher()
    {
        error = null;

        if (editing)
        {
            var teacher = await Db.Teachers.FindAsync(editingId);
            if (teacher != null)
            {
                teacher.Name = editModel.Name;
                message = "Teacher updated successfully.";
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(editModel.Email) || string.IsNullOrWhiteSpace(editModel.Password))
            {
                error = "Email and password are required for new teachers.";
                return;
            }

            var existingUser = await UserManager.FindByEmailAsync(editModel.Email);
            if (existingUser != null)
            {
                error = "A user with this email already exists.";
                return;
            }

            var user = new ApplicationUser
            {
                UserName = editModel.Email,
                Email = editModel.Email,
                FullName = editModel.Name,
                Role = UserRole.Teacher,
                EmailConfirmed = true
            };

            var result = await UserManager.CreateAsync(user, editModel.Password);
            if (!result.Succeeded)
            {
                error = $"Failed to create user: {string.Join(", ", result.Errors.Select(e => e.Description))}";
                return;
            }

            await UserManager.AddToRoleAsync(user, "Teacher");

            var teacher = new Teacher
            {
                UserId = user.Id,
                Name = editModel.Name
            };
            Db.Teachers.Add(teacher);
            await Db.SaveChangesAsync();
            message = $"Teacher '{teacher.Name}' created with login: {editModel.Email}";
        }

        await Db.SaveChangesAsync();
        await LoadTeachers();
        showModal = false;
        editModel = new();
        editing = false;
    }

    private async Task ConfirmDelete()
    {
        if (deletingTeacher == null) return;

        var user = await UserManager.FindByIdAsync(deletingTeacher.UserId);
        if (user != null)
            await UserManager.DeleteAsync(user);

        Db.Teachers.Remove(deletingTeacher);
        await Db.SaveChangesAsync();
        await LoadTeachers();
        message = $"Teacher '{deletingTeacher.Name}' deleted.";
        showDeleteModal = false;
        deletingTeacher = null;
    }

    private class TeacherEditModel
    {
        public string Name { get; set; } = "";
        public string? Email { get; set; }
        public string? Password { get; set; }
    }
}