@page "/teacher/invoices"
@attribute [Authorize(Roles = "Teacher")]
@rendermode InteractiveServer
@inject AppDbContext Db
@inject ITenantContext Tenant
@inject ILogger<Invoices> Logger

<div class="content-area">
    <div class="page-header">
        <div>
            <h1>Billing & Invoices</h1>
            <p class="page-subtitle">View invoices generated for your bookshops</p>
        </div>
    </div>

    <div class="content-card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5>Invoices <span class="text-muted fs-6 fw-normal">(@total invoices)</span></h5>
        </div>
        <div class="card-body p-0">
            @if (invoices == null)
            {
                <div class="loading-placeholder">Loading...</div>
            }
            else if (!invoices.Any())
            {
                <div class="empty-state">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--gray-300)" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <p>No invoices yet. Invoices are generated when you reset bookshop statistics.</p>
                </div>
            }
            else
            {
                <div class="table-container">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Bookshop</th>
                                <th>Period</th>
                                <th>Copies</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in invoices)
                            {
                                <tr>
                                    <td><strong>@inv.BookshopName</strong></td>
                                    <td><small class="text-muted">@inv.PeriodStart.ToString("dd/MM/yyyy") - @inv.PeriodEnd.ToString("dd/MM/yyyy")</small></td>
                                    <td><span class="status-badge status-active">@inv.TotalCopies</span></td>
                                    <td><strong>@inv.TotalAmount.ToString("N2") @inv.Currency</strong></td>
                                    <td>
                                        <span class="status-badge @(inv.Status == "Paid" ? "status-active" : "status-warning")">
                                            <span class="status-dot"></span>
                                            @inv.Status
                                        </span>
                                    </td>
                                    <td><small class="text-muted">@inv.CreatedAt.ToString("g")</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<InvoiceView>? invoices;
    private int total;

    protected override async Task OnInitializedAsync()
    {
        await Tenant.InitializeAsync();
        if (Tenant.TeacherId == null) return;
        var tid = Tenant.TeacherId.Value;
        var query = Db.Invoices
            .AsNoTracking()
            .Where(i => i.Link.TeacherId == tid)
            .Include(i => i.Link).ThenInclude(l => l.Bookshop)
            .OrderByDescending(i => i.CreatedAt);
        total = await query.CountAsync();
        invoices = await query.Select(i => new InvoiceView
        {
            Id = i.Id,
            TeacherBookshopLinkId = i.TeacherBookshopLinkId,
            BookshopName = i.Link.Bookshop.Name,
            PeriodStart = i.PeriodStart,
            PeriodEnd = i.PeriodEnd,
            TotalCopies = i.TotalCopies,
            Currency = i.Currency,
            TotalAmount = i.TotalAmount,
            Status = i.Status.ToString(),
            CreatedAt = i.CreatedAt,
            PaidAt = i.PaidAt
        }).ToListAsync();
    }

    private class InvoiceView
    {
        public int Id { get; set; }
        public int TeacherBookshopLinkId { get; set; }
        public string BookshopName { get; set; } = "";
        public DateTime PeriodStart { get; set; }
        public DateTime PeriodEnd { get; set; }
        public int TotalCopies { get; set; }
        public string Currency { get; set; } = "EGP";
        public decimal TotalAmount { get; set; }
        public string Status { get; set; } = "Pending";
        public DateTime CreatedAt { get; set; }
        public DateTime? PaidAt { get; set; }
    }
}