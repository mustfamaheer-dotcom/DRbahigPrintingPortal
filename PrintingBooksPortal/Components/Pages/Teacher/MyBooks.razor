@page "/teacher/mybooks"
@attribute [Authorize(Roles = "Teacher")]
@rendermode InteractiveServer
@inject AppDbContext Db
@inject ITenantContext Tenant
@inject NavigationManager Navigation
@inject FileStorageService FileStorage
@inject IWebHostEnvironment Env
@inject ILogger<MyBooks> Logger

<div class="content-area">
    <div class="page-header">
        <div>
            <h1>My Books</h1>
            <p class="page-subtitle">Upload and manage your books by board</p>
        </div>
        <div class="page-header-actions">
            <button class="btn btn-primary" @onclick="() => { uploadModel = new(); showUploadModal = true; }">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                Upload Book
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-modern alert-success">@message</div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-modern alert-danger">@error</div>
    }

    @* Upload Modal *@
    <div class="modal-overlay @(showUploadModal ? "show" : "")" @onclick="() => showUploadModal = false">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <h5 class="modal-title">Upload New Book</h5>
                <button type="button" class="modal-close" @onclick="() => showUploadModal = false">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Book Title</label>
                    <input @bind="uploadModel.Title" class="form-control form-control-modern" placeholder="Enter book title" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Board</label>
                    <select @bind="uploadModel.BoardId" class="form-control form-control-modern">
                        <option value="0">-- Select Board --</option>
                        @if (boards != null)
                        {
                            @foreach (var b in boards)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">PDF File</label>
                    <input type="file" @onchange="OnFileSelected" accept=".pdf" class="form-control form-control-modern" />
                    @if (!string.IsNullOrEmpty(selectedFileName))
                    {
                        <small class="text-muted">@selectedFileName (@(fileSizeBytes > 0 ? $"{fileSizeBytes / 1024.0:F1} KB" : ""))</small>
                    }
                </div>
                <div class="mb-4">
                    <label class="form-check-label d-flex align-items-center gap-2">
                        <input type="checkbox" @bind="uploadModel.EnableWatermark" class="form-check-input" />
                        <span>Enable watermark protection</span>
                    </label>
                    <small class="text-muted d-block mt-1">When enabled, a watermark with shop name will be shown during printing.</small>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => showUploadModal = false">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="UploadBook" disabled="string.IsNullOrWhiteSpace(uploadModel.Title) || uploadModel.BoardId == 0 || bookFile == null">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        Upload
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (booksByBoard == null)
    {
        <div class="loading-placeholder">Loading...</div>
    }
    else if (!booksByBoard.Any())
    {
        <div class="content-card">
            <div class="card-body">
                <div class="empty-state">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--gray-300)" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    <p>No books yet. Upload your first book.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        @foreach (var group in booksByBoard)
        {
            <div class="content-card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5>@group.BoardName <span class="text-muted fs-6 fw-normal">(@group.Books.Count book(s))</span></h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-container">
                        <table class="table table-modern">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>File</th>
                                    <th>Pages</th>
                                    <th>Size</th>
                                    <th>Watermark</th>
                                    <th>Status</th>
                                    <th>Uploaded</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var book in group.Books)
                                {
                                    <tr>
                                        <td><strong>@book.Title</strong></td>
                                        <td class="text-muted">@book.OriginalFileName</td>
                                        <td>@book.PageCount</td>
                                        <td class="text-muted">@FormatSize(book.FileSizeBytes)</td>
                                        <td>
                                            <span class="status-badge @(book.EnableWatermark ? "status-active" : "status-inactive")">
                                                <span class="status-dot"></span>
                                                @(book.EnableWatermark ? "On" : "Off")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="status-badge @(book.IsActive ? "status-active" : "status-inactive")">
                                                <span class="status-dot"></span>
                                                @(book.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td class="text-muted">@book.CreatedAt.ToLocalTime().ToString("d")</td>
                                        <td class="text-end">
                                            <div class="action-btns">
                                                <button class="btn-icon btn-icon-view" title="Open" @onclick="() => OpenViewer(book.Id)">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                                </button>
                                                <button class="btn-icon btn-icon-toggle" title="Toggle Watermark" @onclick="() => ToggleWatermark(book)">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                                                </button>
                                                <button class="btn-icon btn-icon-toggle" title="Toggle Active" @onclick="() => ToggleBook(book)">
                                                    @if (book.IsActive)
                                                    {
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                                    }
                                                    else
                                                    {
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                                    }
                                                </button>
                                                <button class="btn-icon btn-icon-danger" title="Delete" @onclick="() => { deletingBook = book; showDeleteConfirm = true; }">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }

    @* Delete Confirmation *@
    <div class="modal-overlay @(showDeleteConfirm ? "show" : "")" @onclick="() => showDeleteConfirm = false">
        <div class="modal-container modal-sm" @onclick:stopPropagation>
            <div class="modal-body text-center py-4">
                <div class="delete-icon mb-3">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--danger)" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                </div>
                <h5 class="mb-2">Delete Book</h5>
                <p class="text-muted mb-3">Are you sure you want to delete <strong>@deletingBook?.Title</strong>?</p>
                <div class="modal-actions justify-content-center">
                    <button class="btn btn-outline-secondary" @onclick="() => showDeleteConfirm = false">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<EducationalBoard>? boards;
    private List<BoardGroup>? booksByBoard;
    private BookUploadModel uploadModel = new();
    private IBrowserFile? bookFile;
    private string? selectedFileName;
    private long fileSizeBytes;
    private bool showUploadModal;
    private bool showDeleteConfirm;
    private Book? deletingBook;
    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await Tenant.InitializeAsync();
        await LoadData();
    }

    private async Task LoadData()
    {
        if (Tenant.TeacherId == null) return;
        var tid = Tenant.TeacherId.Value;

        boards = await Db.EducationalBoards
            .AsNoTracking()
            .Where(b => b.TeacherId == tid && b.IsActive)
            .OrderBy(b => b.Name)
            .ToListAsync();

        var books = await Db.Books
            .AsNoTracking()
            .Where(b => b.TeacherId == tid)
            .Include(b => b.Board)
            .OrderByDescending(b => b.CreatedAt)
            .ToListAsync();

        booksByBoard = books
            .GroupBy(b => b.Board.Name)
            .Select(g => new BoardGroup { BoardName = g.Key, Books = g.ToList() })
            .ToList();
    }

    private void OnFileSelected(ChangeEventArgs e)
    {
        bookFile = null;
        selectedFileName = null;
        fileSizeBytes = 0;

        if (e.Value is string path && !string.IsNullOrEmpty(path))
        {
            selectedFileName = Path.GetFileName(path);
        }
    }

    private async Task UploadBook()
    {
        error = null;
        if (Tenant.TeacherId == null || bookFile == null) return;

        try
        {
            if (!bookFile.ContentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase))
            {
                error = "Only PDF files are allowed.";
                return;
            }

            var fileName = $"{Guid.NewGuid():N}.pdf";
            var storagePath = Path.Combine(Env.ContentRootPath, "App_Data", "Books");
            Directory.CreateDirectory(storagePath);
            var filePath = Path.Combine(storagePath, fileName);

            await using (var stream = new FileStream(filePath, FileMode.Create))
            {
                await bookFile.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024).CopyToAsync(stream);
            }

            var book = new Book
            {
                TeacherId = Tenant.TeacherId.Value,
                BoardId = uploadModel.BoardId,
                Title = uploadModel.Title,
                FilePath = fileName,
                OriginalFileName = uploadModel.Title + ".pdf",
                FileSizeBytes = new FileInfo(filePath).Length,
                PageCount = 1,
                IsActive = true,
                EnableWatermark = uploadModel.EnableWatermark
            };
            Db.Books.Add(book);
            await Db.SaveChangesAsync();
            message = $"Book '{uploadModel.Title}' uploaded successfully.";
            showUploadModal = false;
            uploadModel = new();
            bookFile = null;
            selectedFileName = null;
            await LoadData();
        }
        catch (Exception ex)
        {
            error = $"Upload failed: {ex.Message}";
        }
    }

    private async Task ToggleWatermark(Book book)
    {
        book.EnableWatermark = !book.EnableWatermark;
        await Db.SaveChangesAsync();
        await LoadData();
    }

    private void OpenViewer(int bookId)
    {
        Navigation.NavigateTo($"/teacher/viewer/{bookId}");
    }

    private async Task ToggleBook(Book book)
    {
        book.IsActive = !book.IsActive;
        await Db.SaveChangesAsync();
        await LoadData();
    }

    private async Task ConfirmDelete()
    {
        if (deletingBook == null) return;
        var storagePath = Path.Combine(Env.ContentRootPath, "App_Data", "Books", deletingBook.FilePath);
        if (File.Exists(storagePath)) File.Delete(storagePath);
        Db.Books.Remove(deletingBook);
        await Db.SaveChangesAsync();
        await LoadData();
        message = $"Book '{deletingBook.Title}' deleted.";
        showDeleteConfirm = false;
        deletingBook = null;
    }

    private static string FormatSize(long bytes)
    {
        return bytes switch
        {
            >= 1_000_000 => $"{bytes / 1_000_000.0:F1} MB",
            >= 1_000 => $"{bytes / 1_000.0:F1} KB",
            _ => $"{bytes} B"
        };
    }

    private class BookUploadModel
    {
        public string Title { get; set; } = "";
        public int BoardId { get; set; }
        public bool EnableWatermark { get; set; } = true;
    }

    private class BoardGroup
    {
        public string BoardName { get; set; } = "";
        public List<Book> Books { get; set; } = new();
    }
}